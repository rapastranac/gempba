# Maintainer: Andres Pastrana <gempba@outlook.com>

_realname=gempba
pkgbase=mingw-w64-${_realname}
pkgname=(
    "${MINGW_PACKAGE_PREFIX}-${_realname}"
    "${MINGW_PACKAGE_PREFIX}-${_realname}-mpi"
)
pkgver=5.0.0
pkgrel=1
pkgdesc="Generic Massive Parallelisation of Branching Algorithms — hybrid parallel C++23 framework (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url="https://github.com/rapastranac/gempba"
license=('spdx:MIT')
makedepends=(
    "${MINGW_PACKAGE_PREFIX}-cmake"
    "${MINGW_PACKAGE_PREFIX}-gcc"
    "${MINGW_PACKAGE_PREFIX}-ninja"
    "${MINGW_PACKAGE_PREFIX}-pkgconf"
    "${MINGW_PACKAGE_PREFIX}-spdlog"
    "${MINGW_PACKAGE_PREFIX}-fmt"
    "${MINGW_PACKAGE_PREFIX}-hwloc"
)
source=("${_realname}-${pkgver}.tar.gz::https://github.com/rapastranac/gempba/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('30ee6fad22a8e25a116c1e294fc4ddb4d1aea314e8ec0ee5a43f19bfa4b45450')

build() {
    # One build of the core; the MPI component installs as source, which the consumer's build compiles.
    mkdir -p "${srcdir}/build-${MSYSTEM}"
    cd "${srcdir}/build-${MSYSTEM}"

    MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    ${MINGW_PREFIX}/bin/cmake \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
        -DGEMPBA_BUILD_TESTS=OFF \
        -DGEMPBA_BUILD_MPI=OFF \
        "../${_realname}-${pkgver}"

    ${MINGW_PREFIX}/bin/cmake --build . --parallel
}

package_gempba() {
    pkgdesc="GemPBA — the core (development files, mingw-w64)"
    depends=(
        "${MINGW_PACKAGE_PREFIX}-gcc-libs"
        "${MINGW_PACKAGE_PREFIX}-hwloc"
    )

    cd "${srcdir}/build-${MSYSTEM}"
    DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake --install . --component core

    install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" \
        "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}

package_gempba-mpi() {
    pkgdesc="GemPBA — the MPI component, as source compiled against MS-MPI in the consumer's build (mingw-w64)"
    depends=(
        "${MINGW_PACKAGE_PREFIX}-${_realname}=${pkgver}-${pkgrel}"
        "${MINGW_PACKAGE_PREFIX}-msmpi"
    )

    cd "${srcdir}/build-${MSYSTEM}"
    DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake --install . --component mpi
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
    _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
    _func="$(declare -f "${_short}")"
    eval "${_func/#${_short}/package_${_name}}"
done
# template end;
