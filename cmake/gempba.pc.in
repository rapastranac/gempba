prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: gempba
Description: Generic Massive Parallelisation of Branching Algorithms — hybrid parallel C++23 framework
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lgempba @GEMPBA_PC_STACKTRACE_LIBS@ -lpthread
Cflags: -I${includedir} -std=c++23 @GEMPBA_PC_STACKTRACE_CFLAGS@
