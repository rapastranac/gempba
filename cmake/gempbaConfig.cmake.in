@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# gempba::gempba, the core. Its own dependencies are inside libgempba; consumers only need the threads library.
find_dependency(Threads REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/gempba-targets.cmake")

# gempba::mpi, the MPI component, from find_package(gempba COMPONENTS mpi). Its package installs the targets file.
foreach (_gempba_comp IN LISTS gempba_FIND_COMPONENTS)
    if (_gempba_comp STREQUAL "mpi" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/gempba-mpi-targets.cmake")
        set(MPI_CXX_SKIP_MPICXX ON)
        find_dependency(MPI REQUIRED)
        include("${CMAKE_CURRENT_LIST_DIR}/gempba-mpi-targets.cmake")
        set(gempba_mpi_FOUND TRUE)
    else ()
        set(gempba_${_gempba_comp}_FOUND FALSE)
    endif ()
endforeach ()
unset(_gempba_comp)

check_required_components(gempba)
